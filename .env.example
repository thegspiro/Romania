# ---------------------------------------------------------------------------
# Dissertation platform configuration
#
# Copy to .env and edit. Every value below is read at startup and validated;
# the process refuses to start on an invalid or missing required value rather
# than running with an unsafe default.
#
# NEVER commit a real .env. Secrets belong in environment variables or, in
# Docker/Swarm, in files referenced by the *_FILE variants.
#
# Compose loads this whole file into every service that lists it, so
# docker-compose.yml empties the entries a given container has no code to read:
# the web service gets neither DB_ROOT_PASSWORD nor ZOTERO_API_KEY. Adding a
# credential here that only the worker uses means emptying it for `web` too --
# CI fails until you do.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- HTTP ------------------------------------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# The externally visible origin of the site. Used to build absolute URLs and
# to validate redirects. Must match what visitors actually type.
PUBLIC_BASE_URL=http://localhost:8080

# Set to true when running behind a reverse proxy (SWAG, Nginx Proxy Manager,
# Traefik, Cloudflare Tunnel, ALB) so client IPs and the HTTPS scheme are read
# from X-Forwarded-* headers. Leave false when the app is exposed directly:
# trusting these headers without a proxy in front lets clients spoof their IP.
TRUST_PROXY=false

# --- Database --------------------------------------------------------------
# "db" is the bundled MySQL service in docker-compose.yml. Point this at a
# managed database (RDS, Cloud SQL) to use one instead -- the compose file
# reads this value rather than hard-coding the service name. For a MySQL
# running on your own machine during development, use 127.0.0.1.
DB_HOST=db
DB_PORT=3306
DB_NAME=dissertation
DB_USER=dissertation
# Provide exactly one of DB_PASSWORD or DB_PASSWORD_FILE.
#
# DB_PASSWORD_FILE is read by the web service, the worker and wait-for-db.sh,
# so it covers every application container -- but the bundled `db` service
# still needs DB_PASSWORD here to create the account on first run. Use the
# _FILE form with a database you manage yourself, not with the bundled one.
#
# In production the application refuses to start on the placeholder below.
# Generate a real one: openssl rand -base64 24
DB_PASSWORD=change-me
#DB_PASSWORD_FILE=/run/secrets/db_password
DB_CONNECTION_LIMIT=10

# Only used by the bundled MySQL container in docker-compose.yml, to create the
# database on first run. The application itself never connects as root. Not
# needed when pointing DB_HOST at a database you already run.
DB_ROOT_PASSWORD=change-me-too

# How long the entrypoint waits for the database to accept connections before
# giving up and failing the container, in seconds.
#DB_WAIT_TIMEOUT=120

# Set to false to start the web service without applying pending migrations.
# docker-compose.yml sets it for the worker, so only one role ever migrates.
#RUN_MIGRATIONS=true

# --- Sessions --------------------------------------------------------------
# Rolling session lifetime. Idle sessions past this age are rejected and swept.
SESSION_TTL_HOURS=720
# Must be true in production. When true the cookie is issued with the __Host-
# prefix, Secure and SameSite=Lax. Browsers treat http://localhost as a secure
# context, so this can stay true for local development too.
SESSION_SECURE_COOKIES=true

# --- WebAuthn / passkeys ---------------------------------------------------
# The Relying Party ID is the registered domain, WITHOUT scheme or port.
# Use "localhost" for local development.
#
# WARNING: changing RP_ID after passkeys have been registered invalidates every
# one of them. You would need the password plus a recovery code to get back in.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Dissertation Platform
# Full origin including scheme and, if non-default, port. Comma-separate to
# allow more than one (for example during a domain migration).
WEBAUTHN_ORIGIN=http://localhost:8080

# --- Password hashing (Argon2id) -------------------------------------------
# Defaults follow OWASP guidance: 64 MiB memory, 3 iterations, 1 lane.
# Raising memory cost is the most effective hardening; keep it below what the
# container is allowed to allocate.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# --- Login throttling ------------------------------------------------------
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# --- Rate limiting ---------------------------------------------------------
# Requests per window per address, for anonymous traffic. A signed-in
# administrator is exempt, and so is the container healthcheck.
#
# The default is generous on purpose. Every route that serves a file reads
# from disk on each request and the published manuscript download is
# uncacheable by design, so the limit exists to bound that -- not to ration
# reading. A page with its vendored CSS, JS and images is a handful of
# requests, so 300 a minute is roughly thirty page loads a minute from one
# address.
#
# IMPORTANT: this keys on TRUST_PROXY. With it false, the address is the
# socket's, so behind a reverse proxy every visitor counts into the *same*
# bucket and a busy afternoon can lock the site for everyone. Set
# TRUST_PROXY=true whenever something terminates TLS in front of this.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60

# --- Image -----------------------------------------------------------------
# Which published image the stack runs. Unset follows `latest`, which moves
# with every merge to main. Pin a deployment to an immutable tag instead:
#
#   IMAGE_TAG=sha-1a2b3c4d5e6f
#
# Tags are listed at ghcr.io/thegspiro/romania. Ignored when you build locally
# with `docker compose up -d --build`, which is what an Unraid install needing
# a different APP_UID does.
#IMAGE_TAG=latest

# --- Container user --------------------------------------------------------
# The uid and gid the web and worker containers run as. Baked into the image at
# build time, so changing either needs `docker compose up -d --build`.
#
# The default, 1000:1000, is the base image's own `node` user and is right on
# most Docker hosts. Set them when a bind-mounted directory on the host is
# owned by something else and the container has to write to it.
#
# On Unraid, shares are owned by nobody:users -- uid 99, gid 100:
#
#   APP_UID=99
#   APP_GID=100
#
# Changing these on an existing install does NOT move the data. Files already
# written stay owned by the old uid, so chown them to the new one at the same
# time or the containers will not be able to read what they wrote yesterday.
#APP_UID=1000
#APP_GID=1000

# --- File storage ----------------------------------------------------------
# Directory holding uploaded originals and generated derivatives, addressed by
# content hash. On Unraid, bind-mount an array share here.
STORAGE_ROOT=/data/files
UPLOAD_MAX_BYTES=209715200

# --- Public site behaviour -------------------------------------------------
# When false, robots.txt disallows everything and every response carries
# X-Robots-Tag: noindex, nofollow. Flip to true only when you are ready for the
# public pages to be indexed and archived; prior indexing is hard to undo.
ALLOW_SEARCH_INDEXING=false

# --- Worker ----------------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_MAX_ATTEMPTS=5
WORKER_BATCH_SIZE=1
# A job still marked running after this long is assumed to have died with its
# worker and is returned to the queue.
WORKER_STALE_LOCK_MINUTES=30

# Nominatim asks that every client identify itself with a real contact address.
# Geocoding jobs fail fast rather than send anonymous traffic.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=dissertation-platform/0.1 (you@example.org)

# Destination for scheduled database and file backups.
BACKUP_ROOT=/data/backups

# --- Zotero -----------------------------------------------------------------
# Optional. With both of these set, /admin/sources grows a "Sync from Zotero"
# button and the worker keeps the bibliography in step with the library.
#
# ZOTERO_LIBRARY_ID is the numeric id shown at zotero.org/settings/keys, not
# your username. ZOTERO_API_KEY is created on the same page and needs only
# read access to the library -- nothing here ever writes to Zotero. The key is
# read by the worker alone; the web service never sees it.
#
# The worker needs outbound HTTPS to api.zotero.org for this to work.
#ZOTERO_LIBRARY_TYPE=user
#ZOTERO_LIBRARY_ID=123456
#ZOTERO_API_KEY=
# ZOTERO_API_KEY_FILE=/run/secrets/zotero_api_key   # the _FILE form also works

# --- Maps -------------------------------------------------------------------
#
# Unset by default, and the maps work without it: markers are drawn on a plain
# canvas with a scale bar, and the browser contacts nobody but this server.
#
# Setting a tile host is a deliberate trade. Tile URLs encode the coordinates
# and zoom level being looked at, so the host learns which places are being
# read -- including the private ones you are reviewing while signed in. That is
# the reason this is opt-in rather than a default pointing at OpenStreetMap.
#
# The host must be literal: a {s} subdomain placeholder is rejected, because
# exactly one origin is added to img-src in the Content-Security-Policy and a
# pattern there would either widen the policy or be ignored by the browser.
# Sharding buys nothing over HTTP/2.
#
# Attribution is required whenever a tile URL is set. Check your provider's
# terms for the wording they require, and their policy on use by a third party
# -- OpenStreetMap's own tile servers are not intended for applications.
#MAP_TILE_URL=https://tiles.example.org/{z}/{x}/{y}.png
#MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
