{% extends "layouts/base.njk" %}

{% block title %}{{ record.title }} — Dissertation Research{% endblock %}

{% block head %}<link rel="canonical" href="{{ canonicalUrl }}" />{% endblock %}

{% block content %}
  <article class="entity">
    <header>
      <p class="kicker">{{ labels.singular }}</p>
      <h1>{{ record.title }}</h1>
      {% if record.titleOriginal %}
        <p class="title-original"{% if record.language %} lang="{{ record.language }}"{% endif %}>
          {{ record.titleOriginal }}
        </p>
      {% endif %}
      {% if record.visibility != 'public' %}
        <p class="badge badge-private">Private — visible to you because you are signed in.</p>
      {% endif %}
    </header>

    {% if summaryHtml %}
      {# Rendered by renderFragment with html:false, so it carries no markup
         the author did not write in Markdown. #}
      <div class="prose">{{ summaryHtml | safe }}</div>
    {% endif %}

    <section>
      <h2>Details</h2>
      <dl class="details">
        {% if kind == 'person' %}
          {% if record.detail.familyName or record.detail.givenName %}
            <dt>Name</dt><dd>{{ record.detail.givenName }} {{ record.detail.familyName }}</dd>
          {% endif %}
          {% if record.detail.birthDate %}<dt>Born</dt><dd>{{ record.detail.birthDate }}</dd>{% endif %}
          {% if record.detail.deathDate %}<dt>Died</dt><dd>{{ record.detail.deathDate }}</dd>{% endif %}
          {% if record.detail.occupation %}<dt>Role</dt><dd>{{ record.detail.occupation }}</dd>{% endif %}
        {% elif kind == 'organization' %}
          {% if record.detail.foundedDate %}<dt>Founded</dt><dd>{{ record.detail.foundedDate }}</dd>{% endif %}
          {% if record.detail.dissolvedDate %}<dt>Dissolved</dt><dd>{{ record.detail.dissolvedDate }}</dd>{% endif %}
          {% if record.detail.occupation %}<dt>Type</dt><dd>{{ record.detail.occupation }}</dd>{% endif %}
        {% elif kind == 'place' %}
          {% if record.detail.latitude is not none %}
            <dt>Coordinates</dt>
            <dd>
              {{ record.detail.latitude }}, {{ record.detail.longitude }}
              <span class="muted small">({{ record.detail.geocodePrecision }})</span>
            </dd>
          {% endif %}
          {% if record.detail.adminArea %}<dt>Region</dt><dd>{{ record.detail.adminArea }}</dd>{% endif %}
          {% if record.detail.countryCode %}<dt>Country</dt><dd>{{ record.detail.countryCode }}</dd>{% endif %}
          {% if record.detail.historicalNames %}
            <dt>Also known as</dt><dd>{{ record.detail.historicalNames }}</dd>
          {% endif %}
        {% elif kind == 'event' %}
          {#
            One formatted string from `formatEventDate`, which is the only
            thing that knows a date stored as 1944-01-01 at year precision
            means "1944". The template must not print the raw column.

            The place comes from the same read that resolves it for every
            listing, so a private one is absent here for the same reason and
            in the same way -- no title, no slug, no id.
          #}
          {% if event %}
            <dt>Date</dt><dd>{{ event.dateLabel }}</dd>
            {% if event.place %}
              <dt>Place</dt><dd><a href="{{ event.place.href }}">{{ event.place.title }}</a></dd>
            {% endif %}
          {% endif %}
        {% endif %}

        {% if record.detail.alternateNames %}
          <dt>Other names</dt><dd>{{ record.detail.alternateNames }}</dd>
        {% endif %}
      </dl>
    </section>

    {% if rendered %}
      <section>
        <h2>
          {% if kind == 'person' %}Biography
          {% elif kind == 'event' %}Account
          {% else %}Description{% endif %}
        </h2>
        {# markdown-it with html:false, references resolved for this viewer. #}
        <div class="prose">{{ rendered.html | safe }}</div>

        {% if rendered.footnotes.length > 0 %}
          <ol class="footnotes">
            {% for note in rendered.footnotes %}
              <li id="fn-{{ note.number }}">
                {# citeproc output, already through sanitizeCitationHtml. #}
                {{ note.html | safe }}
                <a href="#fnref-{{ note.number }}" class="footnote-back" aria-label="Back to text">↩</a>
              </li>
            {% endfor %}
          </ol>
        {% endif %}
      </section>
    {% endif %}

    {% set editable = false %}
    {% set chronologyHeading = 'In time' if kind == 'event' else 'Chronology' %}
    {% set chronologyEmpty = 'No connected events recorded yet.' %}
    {% include "partials/chronology.njk" %}
    {% include "partials/relationships.njk" %}
    {% include "partials/mentions.njk" %}
    {% include "partials/graph.njk" %}

    {% if isAdmin %}
      <p class="admin-actions">
        <a href="/admin/{{ path }}/{{ record.id }}/edit">Edit this {{ labels.singular | lower }}</a>
      </p>
    {% endif %}
  </article>
{% endblock %}

{% block scripts %}
  <script nonce="{{ nonce }}" src="/assets/vendor/cytoscape/cytoscape.min.js"></script>
  <script nonce="{{ nonce }}" src="/assets/js/graph.js"></script>
{% endblock %}
