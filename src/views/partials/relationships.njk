{#
  Typed relationships, and the form to add one.

  `listRelationshipsFor` has already applied the visibility rule to the edge
  and to both endpoints, so anything reaching this template is showable.

  An edge may carry the office it was held in and the period it held for. Both
  are plain text under autoescape -- never marked safe, because the operator
  types them.

  `record` is whichever item's page this is. Every kind that may be an end of
  an edge sets it before including this, so one form serves them all.
#}
<section class="relationships">
  <h2>Roles and relationships</h2>

  {% if relationships.length == 0 %}
    <p class="empty">No relationships recorded.</p>
  {% else %}
    <ul class="relationship-list">
      {% for relationship in relationships %}
        <li>
          <span class="relationship-label">{{ relationship.label }}</span>
          <a href="{{ relationship.other.href }}">{{ relationship.other.title }}</a>
          <span class="muted small">{{ relationship.other.kind }}</span>
          {% if relationship.visibility != 'public' %}
            <span class="badge badge-private">Private</span>
          {% endif %}

          {% if relationship.roleTitle or relationship.periodLabel %}
            <div class="relationship-role">
              {% if relationship.roleTitle %}
                <span class="role-title">{{ relationship.roleTitle }}</span>
              {% endif %}
              {% if relationship.periodLabel %}
                <span class="role-period">{{ relationship.periodLabel }}</span>
              {% endif %}
            </div>
          {% endif %}

          {% if relationship.note %}<div class="muted small">{{ relationship.note }}</div>{% endif %}

          {% if isAdmin and editable %}
            {#
              Publication is a decision about now, so it has to be changeable
              after the fact -- an edge recorded privately and published later
              should not have to be deleted and entered again.
            #}
            <form method="post" action="/admin/relationships/{{ relationship.id }}/visibility" class="inline-form">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
              <input type="hidden" name="returnTo" value="{{ returnTo }}" />
              <input type="hidden" name="visibility"
                     value="{{ 'private' if relationship.visibility == 'public' else 'public' }}" />
              <button type="submit" class="link-button">
                {{ 'Make private' if relationship.visibility == 'public' else 'Make public' }}
              </button>
            </form>
            <form method="post" action="/admin/relationships/{{ relationship.id }}/delete" class="inline-form">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
              <input type="hidden" name="returnTo" value="{{ returnTo }}" />
              <button type="submit" class="link-button danger">Remove</button>
            </form>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  {% if isAdmin and editable %}
    <form method="post" action="/admin/relationships" class="relationship-form">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      <input type="hidden" name="fromItemId" value="{{ record.id }}" />
      <input type="hidden" name="returnTo" value="{{ returnTo }}" />

      {#
        Both readings of every predicate, so an edge can be asserted from
        whichever page it is natural to be on. "Member of" from a person and
        "Has member" from the institution store the same row; the server swaps
        the ends for a reverse reading. A symmetric predicate appears once,
        because its two readings say the same thing.
      #}
      <p class="field">
        <label for="predicate">Relationship</label>
        <select id="predicate" name="predicate" required>
          {% for choice in predicateChoices %}
            <option value="{{ choice.value }}">{{ choice.label }}</option>
          {% endfor %}
        </select>
        <span class="hint">
          Read from this page outward. Choosing “Has member” records the same
          connection as choosing “Member of” from the other item's page.
        </span>
      </p>

      <p class="field">
        <label for="targetKind">To</label>
        <select id="targetKind" name="targetKind">
          <option value="person">Person</option>
          <option value="organization">Organization</option>
          <option value="place">Place</option>
          <option value="event">Event</option>
          <option value="artifact">Artifact</option>
        </select>
      </p>

      {#
        A type-ahead over the admin search, scoped by the kind chosen above.
        Still a plain text input: with JavaScript off you type the slug, which
        is what this field always was.
      #}
      <p class="field">
        <label for="targetSlug">Slug</label>
        <input type="text" id="targetSlug" name="targetSlug" placeholder="ion-antonescu" required
               list="targetSlug-options" autocomplete="off"
               data-slug-picker="person" data-slug-picker-kind-from="targetKind" />
        <datalist id="targetSlug-options"></datalist>
        <span class="hint">
          Start typing the other item's name; the field stores its URL segment.
        </span>
      </p>

      <p class="field">
        <label for="roleTitle">Role or position</label>
        <input type="text" id="roleTitle" name="roleTitle" maxlength="255"
               placeholder="Minister of the Interior" />
        <span class="hint">
          The office or capacity this connection was held in. Leave blank for a
          plain relationship. Record a second post at the same organization as
          its own relationship rather than editing this one.
        </span>
      </p>

      <p class="field">
        <label for="startDate">From</label>
        <input type="date" id="startDate" name="startDate" />
        <span class="hint">Leave blank when the date is not known.</span>
      </p>

      <p class="field">
        <label for="endDate">Until</label>
        <input type="date" id="endDate" name="endDate" />
      </p>

      <p class="field">
        <label for="datePrecision">Date precision</label>
        <select id="datePrecision" name="datePrecision">
          <option value="unknown">Unknown</option>
          <option value="day">Day</option>
          <option value="month">Month</option>
          <option value="year">Year</option>
          <option value="decade">Decade</option>
        </select>
        <span class="hint">
          How much of the dates above is actually known. A date entered as
          1940-01-01 with year precision reads as “1940”.
        </span>
      </p>

      <p class="field">
        <label for="relationshipNote">Note</label>
        <input type="text" id="relationshipNote" name="note" maxlength="500" />
      </p>

      <p class="field">
        <label for="relationshipVisibility">Visibility</label>
        <select id="relationshipVisibility" name="visibility">
          <option value="private">Private</option>
          <option value="public">Public</option>
        </select>
        <span class="hint">
          A relationship can be more sensitive than either page it connects.
        </span>
      </p>

      <button type="submit">Add relationship</button>
    </form>
  {% endif %}
</section>
