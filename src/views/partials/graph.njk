{#
  The relationship network.

  The drawing is progressive enhancement: the roles and relationships list
  above it carries the same information as text, so the page is complete
  without JavaScript and without Cytoscape.

  The year control is an ordinary GET form for the same reason. Submitting it
  reloads the page with `?year=`, which the server re-parses and puts back into
  the data URL below; nothing here depends on the script running.
#}
<section class="graph-section">
  <h2>Connections</h2>
  <p class="hint">
    Solid lines are relationships you recorded; dotted lines are mentions found
    in your writing. Only what you may see is drawn.
  </p>

  <form method="get" action="{{ record.href }}" class="graph-controls">
    <label for="graph-year">Network in year</label>
    <input
      type="number"
      id="graph-year"
      name="year"
      min="1"
      max="9999"
      step="1"
      inputmode="numeric"
      placeholder="1941"
      value="{{ graphYear if graphYear else '' }}"
    />
    <button type="submit">Show</button>
    {% if graphYear %}<a href="{{ record.href }}">Clear</a>{% endif %}
    <span class="hint">
      Draws only the relationships whose period covers that year. A
      relationship with no dates recorded is always drawn, because an unknown
      period is not an absent one.
    </span>
  </form>

  <div
    id="relationship-graph"
    class="graph-canvas"
    data-graph-url="/graph/{{ path }}/{{ record.slug }}.json{% if graphYear %}?year={{ graphYear }}{% endif %}"
    role="img"
    aria-label="Network of connections for {{ record.title }}"
  ></div>

  <p id="graph-status" class="muted small" role="status"></p>
</section>
