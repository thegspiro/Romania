{% extends "layouts/base.njk" %}
{% import "partials/macros.njk" as ui %}

{% block title %}Timeline — Dissertation Research{% endblock %}

{% macro timelineItem(entry) %}
  <li>
    <span class="chronology-date">{{ entry.dateLabel }}</span>
    <a href="{{ entry.href }}">{{ entry.title }}</a>
    {% if entry.place %}
      <span class="chronology-place">{{ entry.place.title }}</span>
    {% endif %}
    {{ ui.badge(entry.visibility) }}
    {% if entry.summary %}
      <div class="muted small">{{ entry.summary }}</div>
    {% endif %}
  </li>
{% endmacro %}

{% block content %}
  <h1>Timeline</h1>
  <p class="muted">
    Events in date order. A date is shown only as precisely as it is known:
    “1943” means the year, not the first of January.
  </p>

  {#
    A GET form, so a filtered chronology has a URL that can be linked and
    bookmarked. No visibility control here: `listTimeline` refuses one from a
    non-administrator, because `?visibility=private` would be a way to
    enumerate unpublished material.
  #}
  <form method="get" action="/timeline" class="filter-form">
    <p class="field">
      <label for="timeline-q">Search</label>
      <input type="search" id="timeline-q" name="q" value="{{ search }}" />
    </p>
    <p class="field">
      <label for="timeline-from">From</label>
      <input type="text" id="timeline-from" name="from" value="{{ from }}"
             inputmode="numeric" placeholder="1940" />
      <span class="hint">A year, or a full date as 1940-06-02.</span>
    </p>
    <p class="field">
      <label for="timeline-to">To</label>
      <input type="text" id="timeline-to" name="to" value="{{ to }}"
             inputmode="numeric" placeholder="1944" />
    </p>
    <p class="field">
      <label for="timeline-place">Place</label>
      <input type="text" id="timeline-place" name="place" value="{{ place }}"
             placeholder="iasi" />
      <span class="hint">The URL segment of a place's page.</span>
    </p>
    <p class="field">
      <label for="timeline-related">Connected to</label>
      <input type="text" id="timeline-related" name="related" value="{{ related }}"
             placeholder="person:ion-antonescu" />
      <span class="hint">
        A kind and a slug, as written in prose: person, organization, place or event.
      </span>
    </p>
    <p class="field">
      <button type="submit">Filter</button>
      <a href="/timeline">Clear</a>
    </p>
  </form>

  {#
    Both exports honour exactly the filters this page honours -- the links carry
    the validated query string, not the raw one -- and both go through
    `listTimeline`, so a download can only hold what this viewer could already
    read a page at a time.
  #}
  <p class="muted small">
    {{ total }} {{ 'event' if total == 1 else 'events' }}.
    Download this chronology as
    <a href="/timeline.csv{% if filterQuery %}?{{ filterQuery }}{% endif %}">a spreadsheet</a>
    or
    <a href="/timeline.ics{% if filterQuery %}?{{ filterQuery }}{% endif %}">a calendar</a>.
  </p>

  {% include "partials/timeline-band.njk" %}

  {% if entries.length == 0 %}
    <p class="empty">Nothing matches those filters.</p>
  {% else %}
    {#
      Headings from `groupEntries`, which decides how wide one may be: never
      finer than the coarsest precision in the list, so a year-precision event
      is never filed under a month the record did not give. A single heading
      over everything says nothing, so it is not drawn.
    #}
    {% if groups.length > 1 %}
      {% for group in groups %}
        <h2 class="chronology-group">{{ group.label }}</h2>
        <ol class="chronology-list timeline-page-list">
          {% for entry in group.entries %}{{ timelineItem(entry) }}{% endfor %}
        </ol>
      {% endfor %}
    {% else %}
      <ol class="chronology-list timeline-page-list">
        {% for entry in entries %}{{ timelineItem(entry) }}{% endfor %}
      </ol>
    {% endif %}

    {{ ui.pagination('/timeline', page, pageCount, search, filterQuery) }}
  {% endif %}
{% endblock %}
