{% extends "layouts/admin.njk" %}
{% import "partials/macros.njk" as ui %}

{% block adminTitle %}{{ 'Manuscript settings' if mode == 'edit' else 'New manuscript' }}{% endblock %}

{% block adminContent %}
  <h1>{{ 'Manuscript settings' if mode == 'edit' else 'New manuscript' }}</h1>

  {{ ui.errorList(errors) }}

  <form method="post" action="{{ action }}" class="stacked-form">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />

    <fieldset>
      <legend>Title page</legend>
      <p class="field">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="{{ values.title | default('') }}" required maxlength="500" />
      </p>
      {{ ui.field('subtitle', 'Subtitle', values) }}
      {{ ui.field('authorName', 'Author', values, 'text', 'As it should appear on the title page.') }}
      {{ ui.field('degree', 'Degree', values, 'text', 'For example: Doctor of Philosophy.') }}
      {{ ui.field('institution', 'Institution', values) }}
      {{ ui.field('submittedOn', 'Submission date', values, 'text', 'YYYY-MM-DD.') }}
    </fieldset>

    <fieldset>
      <legend>Front matter</legend>
      {{ ui.area('summary', 'Description', values, 'Shown on the manuscript page, not in the compiled document.', 3) }}
      {{ ui.area('abstractMarkdown', 'Abstract', values, 'Markdown. Included in the compiled document.', 6) }}
      {{ ui.area('acknowledgementsMarkdown', 'Acknowledgements', values, 'Markdown.', 4) }}
    </fieldset>

    <fieldset>
      <legend>Compilation</legend>
      <p class="field checkbox">
        <label>
          <input type="checkbox" name="numberSections" {% if values.numberSections %}checked{% endif %} />
          Number sections in the compiled document
        </label>
      </p>
    </fieldset>

    {{ ui.visibilityFields(values) }}

    <div class="form-actions">
      <button type="submit">{{ 'Save changes' if mode == 'edit' else 'Create manuscript' }}</button>
      <a href="/admin/manuscripts">Cancel</a>
      {% if mode == 'edit' %}
        <a href="/admin/manuscripts/{{ manuscript.id }}/outline">Edit the outline</a>
      {% endif %}
    </div>
  </form>

  {% if mode == 'edit' %}
    <form method="post" action="/admin/manuscripts/{{ manuscript.id }}/delete" class="danger-form">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
      <h2>Delete</h2>
      <p class="hint">
        Deletes the arrangement only. The essays themselves are untouched.
      </p>
      <button type="submit" class="danger">Delete this manuscript</button>
    </form>
  {% endif %}
{% endblock %}
